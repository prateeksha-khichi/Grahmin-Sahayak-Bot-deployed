# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration
DATABASE_URL=postgresql+psycopg://username:password@your-deployment.neon.tech/neondb?sslmode=require

# Optional Webhook Details (for prod instances using webhooks instead of polling)
WEBHOOK_URL=https://your-railway-app.up.railway.app

# Large Model Fix (Google Drive id of the .pkl model)
# e.g. for URL view?id=11TiSpJTC493sAnm0xuooaDc5hGzej6Js:
GOOGLE_DRIVE_MODEL_ID=11TiSpJTC493sAnm0xuooaDc5hGzej6Js

# LLM / AI Integrations (Groq/AssemblyAI etc - insert whatever you use locally)
GROQ_API_KEY=your_groq_api_key
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Additional Services
OPENWEATHER_API_KEY=your_openweather_api_key
